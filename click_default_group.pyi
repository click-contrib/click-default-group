from typing import Any, Callable, List, Optional, Sequence, Tuple, TypeVar, Union

import click

F = TypeVar("F", bound=Callable[..., Any])

class DefaultGroup(click.Group):
    ignore_unknown_options: bool
    default_cmd_name: Optional[str]
    default_if_no_args: bool

    def __init__(self, *args: Any, **kwargs: Any) -> None: ...
    def set_default_command(self, command: click.Command) -> None: ...
    def parse_args(self, ctx: click.Context, args: List[str]) -> List[str]: ...
    def get_command(self, ctx: click.Context, cmd_name: str) -> Optional[click.Command]: ...
    def resolve_command(
        self, ctx: click.Context, args: List[str]
    ) -> Tuple[Optional[str], Optional[click.Command], List[str]]: ...
    def format_commands(self, ctx: click.Context, formatter: click.HelpFormatter) -> None: ...
    def command(self, *args: Any, **kwargs: Any) -> Callable[[F], click.Command]: ...

class DefaultCommandFormatter:
    group: DefaultGroup
    formatter: click.HelpFormatter
    mark: str
    def __init__(self, group: DefaultGroup, formatter: click.HelpFormatter, mark: str = ...) -> None: ...
    def write_dl(self, rows: Sequence[Tuple[str, str]], *args: Any, **kwargs: Any) -> None: ...
